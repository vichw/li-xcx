/* 荣誉榜首页样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f9f9f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 30rpx;
}

/* 顶部横幅 */
.banner {
  width: 100%;
  height: 400rpx;
  position: relative;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
  filter: brightness(0.8);
}

.banner-title {
  position: absolute;
  bottom: 40rpx;
  left: 40rpx;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
  text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
}

/* 快捷入口 */
.quick-entry {
  width: 90%;
  margin: 30rpx 0 20rpx;
  display: flex;
  justify-content: center;
}

.entry-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s;
}

.entry-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.entry-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.entry-text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

/* 荣誉榜标题 */
.honor-list-title {
  width: 90%;
  margin: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A237E;
  margin-bottom: 15rpx;
}

.title-line {
  width: 200rpx;
  height: 6rpx;
  background-color: #FF5722;
  border-radius: 3rpx;
}

/* 加载中状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 100rpx 0;
}

.loading-image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #888888;
}

/* 空数据状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #888888;
}

/* 荣誉列表 */
.honor-list {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.honor-item {
  width: 100%;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  position: relative;
}

/* 学员信息 */
.student-info {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.student-grade{
  margin-top:10rpx;
  /* font-weight: bold; */
  align-items: center;
  text-align: center; 
  /* border-radius: 8px;  */
  border-width: 2px;
  /* border: 1px dashed rgb(190, 186, 186); */
  /* border-style: solid; */
  font-size: 25rpx;
  color: #646060;
}

.student-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #1A237E;
  margin-bottom: 15rpx;
}


.belt-avatar{
  width: 45rpx;
  height: 150rpx;
  border-radius: 20rpx;
  border: 1px solid gray;
  
  margin-left: 15rpx;

}

.user-belt-text {
  
  font-size: 22rpx bold;
  color:black;
  font-weight: bold;
  text-align: center;
  max-width: 250rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


.student-name {
  font-size: 35rpx;
  color: #646060;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 荣誉信息 */
.honor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 奖牌标题区域 */
.award-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.medal-icon {
  width:  80rpx;
  height: 80rpx;
  margin-right: 12rpx;
}

.honor-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  
}

.honor-subtitle {
  font-size: 28rpx;
  color: #555555;
  margin-bottom: 10rpx;
  width: 90%;
}

.honor-date {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 20rpx;
}

/* 荣誉底部热度和分享区域 */
.honor-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.heat-info {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.heat-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.heat-value {
  font-size: 26rpx;
  color: #FF5722;
}

.share-btn {
  padding: 0;
  margin-left:20rpx;
  background: none;
  border: none;
  display: flex;
  align-items: center;
  line-height: normal;
  outline: none;
}

.share-btn::after {
  border: none;
}

.share-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.share-text {
  font-size: 26rpx;
  color: #1A237E;
}

/* 荣誉图片 */
.honor-image {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  border: 2rpx solid #eeeeee;
}

/* 段位图标样式 */
.belt-icon-container {
  position: absolute;
  right: 0rpx;
  top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
}

.belt-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 20rpx solid rgb(229, 128, 128);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.belt-level {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

/* 黑带段位数字样式 */
.belt-level-black {
  color: transparent;
  -webkit-text-stroke: 2px white;
  text-stroke: 2px white;
  text-shadow: none;
  font-weight: 900;
  font-size: 44rpx;
}

.belt-text {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}

/* 搜索框样式 */
.search-container {
  padding: 20rpx 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}

.search-btn {
  background-color: #1aad19;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-left: 10rpx;
} 
.award-body{
  display: flex;
  flex-direction: row;
}

.award-body-left{
  width: 50rpx;
  /* border: 1px solid gray; */
  margin-right: 10rpx ;
}
.award-body-right{
  display: flex;
  flex-direction: column;
  margin-left: 30rpx;
  
}