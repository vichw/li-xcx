/* pages/feedback/feedback-submit/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 标题栏 */
.header {
  background: #fff;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 类型选择 */
.type-tabs {
  display: flex;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  width: 90%;
  border: #faad14 1px solid;
}

.tab-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s;

}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: bold;
}

/* 表单容器 */
.form-container {
  margin: 20rpx 30rpx;
  width: 100%;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #f56c6c;
  margin-right: 8rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* Picker */
.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.picker .placeholder {
  color: #999;
}

.picker .arrow {
  color: #999;
  font-size: 24rpx;
}

/* Input */
.input {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 90%;
}

/* Textarea */
.textarea {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 字数统计 */
.counter {
  text-align: right;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.image-add .icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.image-add .text {
  font-size: 24rpx;
}

/* 只读文本 */
.readonly-text {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 提交按钮 */
.submit-container {
  margin: 40rpx 30rpx 20rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.3);
}

.submit-btn::after {
  border: none;
}

/* 温馨提示 */
.tips {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #fff9e6;
  border-radius: 16rpx;
  border-left: 6rpx solid #faad14;
}

.tips-title {
  font-size: 28rpx;
  color: #fa8c16;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}

