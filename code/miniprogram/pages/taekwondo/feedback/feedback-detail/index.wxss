/* pages/feedback/feedback-detail/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 30rpx 40rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  width: 90%;
}

.type-row {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.type-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.3);
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-pending {
  background: rgba(217, 217, 217, 0.9);
  color: #666;
}

.status-processing {
  background: #faad14;
}

.status-resolved {
  background: #52c41a;
}

.status-closed {
  background: rgba(140, 140, 140, 0.9);
}

.category {
  font-size: 26rpx;
  margin-bottom: 15rpx;
  opacity: 0.9;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1.5;
}

/* 内容卡片 */
.content-card, .info-card, .reply-card, .no-reply-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 90%;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  
}

/* 图片网格 */
.images-section {
  margin-top: 30rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  min-width: 160rpx;
}

.info-row .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.copy-btn {
  padding: 8rpx 20rpx;
  background: #667eea;
  color: #fff;
  font-size: 24rpx;
  border-radius: 16rpx;
  margin-left: 15rpx;
}

/* 回复卡片 */
.reply-card {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-left: 6rpx solid #667eea;
}

.reply-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.reply-info {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.divider {
  color: #d9d9d9;
}

/* 无回复卡片 */
.no-reply-card {
  text-align: center;
  padding: 60rpx 30rpx;
}

.waiting-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.waiting-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.waiting-hint {
  font-size: 24rpx;
  color: #999;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

