/* 课时消费记录页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 课时进度卡片 */
.progress-card {
  width: 80%;
  margin: 20rpx;
  background: linear-gradient(135deg, #1A237E 0%, #3949AB 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 35, 126, 0.3);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.progress-grade {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.progress-content {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.progress-item {
  flex: 1;
  text-align: center;
}

.progress-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.progress-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.progress-value.highlight {
  color: #4CAF50;
}

.progress-value.warning {
  color: #FFB300;
}

.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  min-width: 80rpx;
  text-align: right;
}

/* 列表标题 */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.list-count {
  font-size: 26rpx;
  color: #999;
}

/* 记录列表 */
.record-list {
  padding: 0 20rpx;
  width: 90%;
}

.record-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-left {
  min-width: 140rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-center {
  flex: 1;
  padding: 0 20rpx;
}

.record-source {
  margin-bottom: 8rpx;

}

.source-tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.source-tag.manager {
  background-color: #FFF3E0;
  color: #F57C00;
}

.source-tag.miniprogram {
  background-color: #E8F5E9;
  color: #4CAF50;
}

.record-operator {
  font-size: 24rpx;
  color: #666;
}

.record-right {
  text-align: right;
}

.record-courses, .record-deduct {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.courses-label, .deduct-label {
  font-size: 22rpx;
  color: #999;
}

.courses-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #4CAF50;
}

.deduct-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF5722;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more text {
  font-size: 24rpx;
  color: #ccc;
}

