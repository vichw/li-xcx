<!--比赛详情页面-->
<view class="container">

  <!-- 比赛信息卡片 -->
  <view class="competition-info">
    <view class="info-header">
      <text class="competition-name">{{competition.name}}</text>
      <view class="status-badge {{competition.status}}">
        {{competition.status === 'ongoing' ? '进行中' : '已完成'}}
      </view>
    </view>
    
    <view class="info-body">
      <view class="info-item">
        <text class="label">📅 比赛时间</text>
        <text class="value">{{competition.start_date}} ~ {{competition.end_date}}</text>
      </view>
      <view class="info-item">
        <text class="label">👥 参赛人数</text>
        <text class="value">{{competition.participant_count}}人</text>
      </view>
      <view class="info-item">
        <text class="label">📢 报名状态</text>
        <text class="value {{competition.registration_status === 'open' ? 'open' : 'closed'}}">
          {{competition.registration_status === 'open' ? '报名中' : '已截止'}}
        </text>
      </view>
      <view wx:if="{{isAutoGrouping}}" class="info-item">
        <text class="label">🏷️ 分组模式</text>
        <text class="value">按年龄+性别+体重</text>
      </view>
    </view>

    <!-- 报名按钮 -->
    <button 
      wx:if="{{competition.registration_status === 'open'}}"
      class="register-btn"
      bindtap="goToRegister"
    >
      立即报名
    </button>
  </view>

  <!-- 面包屑导航（自动分组模式且选中了子组时显示） -->
  <view wx:if="{{isAutoGrouping && selectedSubGroup}}" class="breadcrumb">
    <text class="breadcrumb-item" bindtap="backToGroups">所有分组</text>
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-item active">{{selectedSubGroup.sub_group_name}}</text>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view 
      wx:if="{{!selectedSubGroup}}"
      class="tab-item {{activeTab === 'groups' ? 'active' : ''}}"
      data-tab="groups"
      bindtap="switchTab"
    >
      📋 分组情况
    </view>
    <view 
      wx:if="{{selectedSubGroup}}"
      class="tab-item {{activeTab === 'bracket' ? 'active' : ''}}"
      data-tab="bracket"
      bindtap="switchTab"
    >
      ⚔️ 对战表
    </view>
    <view 
      wx:if="{{selectedSubGroup}}"
      class="tab-item {{activeTab === 'result' ? 'active' : ''}}"
      data-tab="result"
      bindtap="switchTab"
    >
      🏆 比赛结果
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <!-- ========== 自动分组模式：分组情况 ========== -->
  <view wx:if="{{isAutoGrouping && activeTab === 'groups' && !loading}}" class="groups-content">
    <view wx:if="{{subGroups.length === 0}}" class="empty">
      <text class="empty-text">暂无分组信息</text>
    </view>
    
    <view wx:else>
      <view wx:for="{{subGroups}}" wx:key="age_group_code" class="age-group-section">
        <view class="age-group-title">{{item.age_group_name}}</view>
        
        <view class="sub-group-grid">
          <view 
            wx:for="{{item.sub_groups}}" 
            wx:key="sub_group_id" 
            wx:for-item="subGroup"
            class="sub-group-card"
            data-id="{{subGroup.sub_group_id}}"
            data-name="{{subGroup.sub_group_name}}"
            bindtap="selectSubGroup"
          >
            <view class="sub-group-name">{{subGroup.sub_group_name}}</view>
            <view class="sub-group-count">{{subGroup.participant_count}}人</view>
            <view class="sub-group-status">
              {{subGroup.bracket_generated ? '✅ 已生成对战表' : '⏳ 未生成'}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 对战表 ========== -->
  <view wx:if="{{activeTab === 'bracket' && !loading}}" class="bracket-content">
    <view wx:if="{{brackets.length === 0}}" class="empty">
      <text class="empty-text">对战表尚未生成</text>
    </view>
    
    <view wx:else>
      <view wx:for="{{rounds}}" wx:key="round" class="round-section">
        <view class="round-title">{{getRoundTitle(item.round, totalRounds)}}</view>
        
        <view class="matches-list">
          <view wx:for="{{item.matches}}" wx:key="_id" wx:for-item="match" class="match-card">
            <view class="match-header">
              <text class="match-no">场次 {{match.match_no}}</text>
            </view>
            
            <view class="match-body">
              <view class="player {{match.winner_id === match.student1_id ? 'winner' : ''}}">
                <text class="player-name">{{match.student1_name || '待定'}}</text>
                <text wx:if="{{match.winner_id === match.student1_id}}" class="trophy">🏆</text>
              </view>
              
              <view class="vs">VS</view>
              
              <view class="player {{match.winner_id === match.student2_id ? 'winner' : ''}}">
                <text class="player-name">{{match.student2_name || '轮空'}}</text>
                <text wx:if="{{match.winner_id === match.student2_id}}" class="trophy">🏆</text>
              </view>
            </view>
            
            <view wx:if="{{match.score}}" class="match-score">
              <text>比分: {{match.score}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 比赛结果 ========== -->
  <view wx:if="{{activeTab === 'result' && !loading}}" class="result-content">
    <view wx:if="{{results.length === 0}}" class="empty">
      <text class="empty-text">暂无比赛结果</text>
    </view>
    
    <view wx:else class="result-list">
      <!-- 按子组分组显示结果 -->
      <view wx:for="{{results}}" wx:key="sub_group_id" wx:for-item="group" class="result-group">
        
        
        <view wx:if="{{group.results.length === 0}}" class="empty-tip">
          <text>该组暂无结果</text>
        </view>
        
        <view wx:else class="group-results">
          <view wx:for="{{group.results}}" wx:key="_id" class="result-card">
            <view class="rank-badge rank-{{item.rank}}">
              <text class="rank-text">{{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : item.rank === 3 ? '🥉' : '第' + item.rank + '名'}}</text>
            </view>
            
            <view class="result-info">
              <text class="student-name">{{item.student_name}}</text>
              <text class="student-detail">{{item.age}}岁 · {{item.gender === 'male' ? '男' : '女'}} · {{item.weight}}kg</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
