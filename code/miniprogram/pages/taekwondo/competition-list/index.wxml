<!--赛事列表页面-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <view class="title">🏆赛事</view>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === 'ongoing' ? 'active' : ''}}"
      data-tab="ongoing"
      bindtap="switchTab"
    >
      进行中
    </view>
    <view 
      class="tab-item {{activeTab === 'finished' ? 'active' : ''}}"
      data-tab="finished"
      bindtap="switchTab"
    >
      已完成
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <!-- 进行中的赛事 -->
  <view wx:if="{{activeTab === 'ongoing' && !loading}}" class="competition-list">
    <view 
      wx:for="{{ongoingCompetitions}}"
      wx:key="_id"
      class="competition-card ongoing"
      data-id="{{item._id}}"
      bindtap="goToDetail"
    >
      <view class="card-header">
        <text class="competition-name">📋 {{item.name}}</text>
        <view class="status-badge ongoing">进行中</view>
      </view>
      
      <view class="card-body">
        <view class="info-row">
          <text class="label">日期:</text>
          <text class="value">{{item.start_date}} ~ {{item.end_date}}</text>
        </view>
        <view class="info-row">
          <text class="label">参赛:</text>
          <text class="value">{{item.participant_count}}人</text>
        </view>
        <view class="info-row">
          <text class="label">报名:</text>
          <view class="registration-status">
            <text class="value">{{item.registration_count || 0}}人</text>
            <text class="status-tag {{item.registration_status === 'open' ? 'open' : 'closed'}}">
              {{item.registration_status === 'open' ? '报名中' : '已截止'}}
            </text>
          </view>
        </view>
      </view>
      
      <view class="card-footer">
        <button 
          wx:if="{{item.registration_status === 'open'}}" 
          class="register-btn"
          data-id="{{item._id}}"
          catchtap="goToRegister"
        >
          立即报名
        </button>
        <text wx:else class="detail-link">查看详情 →</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{ongoingCompetitions.length === 0}}" class="empty">
      <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
      <text class="empty-text">暂无进行中的赛事</text>
    </view>
  </view>

  <!-- 已完成的赛事 -->
  <view wx:if="{{activeTab === 'finished' && !loading}}" class="competition-list">
    <view 
      wx:for="{{finishedCompetitions}}"
      wx:key="_id"
      class="competition-card finished"
      data-id="{{item._id}}"
      bindtap="goToDetail"
    >
      <view class="card-header">
        <text class="competition-name">📋 {{item.name}}</text>
        <view class="status-badge finished">已完成</view>
      </view>
      
      <view class="card-body">
        <view class="info-row">
          <text class="label">日期:</text>
          <text class="value">{{item.start_date}} ~ {{item.end_date}}</text>
        </view>
        <view class="info-row">
          <text class="label">参赛:</text>
          <text class="value">{{item.participant_count}}人</text>
        </view>
      </view>
      
      <view class="card-footer">
        <text class="detail-link">查看详情 →</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{finishedCompetitions.length === 0}}" class="empty">
      <image class="empty-icon" src="/images/icons/competition-empty.png" mode="aspectFit"></image>
      <text class="empty-text">暂无已完成的赛事</text>
    </view>
  </view>
</view>

