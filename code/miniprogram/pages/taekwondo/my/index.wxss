/* 我的页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f9f9f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

/* 未登录状态样式 */
.login-container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  filter: brightness(0.6);
  z-index: -1;
}

.login-content {
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  z-index: 1;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  border-radius: 80rpx;
  border: 4rpx solid #1A237E;
}

.login-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1A237E;
  margin-bottom: 20rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 60rpx;
}

.login-form {
  width: 100%;
}

.input-group {
  width: 100%;
  height: 90rpx;
  background-color: #f5f5f5;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 协议勾选样式 */
.agreement-box {
  width: 100%;
  margin: 20rpx 0;
}

.agreement-wrapper {
  display: flex;
  align-items: flex-start;
}

.checkbox-wrapper {
  flex-shrink: 0;
  margin-right: 8rpx;
}

.agreement-text-wrapper {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-text {
  color: #666;
  margin: 0 4rpx;
}

.agreement-link {
  color: #667eea;
  text-decoration: underline;
  margin: 0 2rpx;
}

.login-btn {
  width: 100%;
  background-color: #1A237E;
  border-radius: 45rpx;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 90rpx;
  text-align: center;
}

/* 已登录状态样式 */
.user-header {
  width: 100%;
  height: 300rpx;
  position: relative;
  overflow: hidden;
}

.user-bg {
  width: 100%;
  height: 100%;
  filter: brightness(0.5);
  opacity: 0.4;
}

.user-info {
  position: absolute;
  bottom: 30rpx;
  left: 0;
  width: 100%;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #ffffff;
  margin-right: 30rpx;
}

.belt-avatar{
  width: 64rpx;
  height: 85rpx;
  border-radius: 20rpx;
  border: 4rpx solid #ffffff;
  margin-bottom: 20rpx;
  margin-right: 10rpx;

}

.user-details {
  flex: 1;
  margin-left: 20rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: black;
  margin-bottom: 10rpx;
}

.user-grade {
  font-size: 28rpx;
  color: #e0e0e0;
  margin-bottom: 6rpx;
}


.user-phone {
  font-size: 28rpx;
  color: black;
  font-weight: bold;
}

/* 用户段位图标 */
.user-belt-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.user-belt {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 5rpx solid #000;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
}

.user-belt-level {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

/* 黑带段位数字样式 */
.user-belt-level-black {
  color: transparent;
  -webkit-text-stroke: 1.5px white;
  text-stroke: 1.5px white;
  text-shadow: none;
  font-weight: 900;
  font-size: 38rpx;
}

.user-belt-text {
  
  font-size: 22rpx bold;
  color:black;
  font-weight: bold;
  text-align: center;
  max-width: 250rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.edit-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  width: 64rpx;
  height: 64rpx;
}

/* 信息卡片样式 */
.info-card {
  width: 90%;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-top: 30rpx;
  overflow: hidden;
}

.card-title {
  padding: 20rpx 30rpx;
  background-color: #1A237E;
  display: flex;
  align-items: center;
}

.card-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.card-title text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.card-content {
  padding: 20rpx 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.active-status {
  color: #4CAF50;
}

.inactive-status {
  color: #FF5722;
}

/* 加载中和空数据状态 */
.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text, .empty-text {
  font-size: 28rpx;
  color: #888888;
}

.empty-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

/* 荣誉列表样式 */
.honor-list {
  padding: 10rpx 30rpx 30rpx;
}

.honor-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.honor-item:last-child {
  border-bottom: none;
}

.honor-left {
  flex: 1;
}

.honor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.honor-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.honor-date {
  font-size: 24rpx;
  color: #999999;
}

.honor-right {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.honor-medal {
  width: 80rpx;
  height: 80rpx;
}

/* 操作按钮区域 */
.action-area {
  width: 90%;
  margin-top: 60rpx;
}

.action-btn {
  width: 100%;
  
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 80rpx;
}

.logout-btn {
  background-color: rgb(172, 167, 167);
  color: white;
}

/* 编辑个人信息弹窗 */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.edit-content {
  width: 80%;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.edit-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  font-size: 38rpx;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像上传区域 */
.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.upload-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 2rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.upload-btn {
  font-size: 28rpx;
  color: #1A237E;
}

/* 表单样式 */
.edit-form {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 15rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-content {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
}

.form-btn {
  width: 100%;
  
  background-color: #1A237E;
  border-radius: 45rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 90rpx;
}

/* 会员费支付状态样式 */
.vip-pay-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pay-time {
  font-size: 24rpx;
  color: #999;
}

.pay-btn {
  margin: 0 auto;
  padding: 0 20rpx;  
  display: block;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 24rpx;
  background-color: #1A237E;
  color: white;
  border-radius: 25rpx;
  text-align: center;
  width: 300rpx !important;
}

/* 投诉建议入口样式 */
.menu-card {
  width: 690rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.red-badge {
  min-width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.red-badge text {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.arrow {
  font-size: 48rpx;
  color: #999;
  font-weight: 300;
}

/* 新版课时进度卡片 */
.course-card-container {
  width: 90%;
  margin-top: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.course-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.course-card-history {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

/* 考级课时卡片 */
.course-progress-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.3);
}

.course-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.course-count {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

/* 新版进度条 */
.course-progress-bar-new {
  margin: 20rpx 0;
}

.progress-bar-bg-new {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill-new {
  height: 100%;
  background: #fff;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.course-progress-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.progress-percentage {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 提示信息 */
.course-tips-new {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-text-new {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
  line-height: 1.5;
}

.course-detail-link {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 16rpx;
  text-decoration: underline;
}

/* 一键刷课按钮 */
.consume-btn-new {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a00 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 154, 86, 0.4);
}

.consume-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.consume-btn-new text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 考级级别信息 */
.grade-info-container {
  width: 90%;
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}

.grade-info-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grade-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.grade-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.grade-value.highlight {
  color: #f5576c;
}

/* 报名费用和状态信息卡片 */
.exam-fee-card {
  width: 90%;
  background: linear-gradient(135deg, #ffd54f 0%, #ffb300 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 179, 0, 0.3);
}

.exam-fee-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.exam-fee-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.exam-fee-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.exam-fee-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #d84315;
}

.exam-fee-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.2) 50%, transparent 100%);
}

.exam-fee-status {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: bold;
}



/* 报名考级按钮 */
.exam-apply-btn {
  background: linear-gradient(135deg, #d84315 0%, #bf360c 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(216, 67, 21, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: #ffffff;
  transition: all 0.3s ease;
}

.exam-apply-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 12rpx rgba(216, 67, 21, 0.5);
}

.exam-apply-btn .btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.exam-apply-btn .btn-text {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 旧版兼容样式 */
.course-progress-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  gap: 20rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 20rpx;
  background-color: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 100%);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  min-width: 80rpx;
  text-align: right;
}

.today-course-info {
  text-align: center;
  margin: 10rpx 0;
}

.today-text {
  font-size: 24rpx;
  color: #999;
}

/* 消课按钮（旧版） */
.consume-btn {
  width: 100%;
  height: 80rpx;
  line-height: 50rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  margin-top: 20rpx;
  border: none;
}

.consume-btn[disabled] {
  background: #ccc;
  color: #999;
}

/* 考级按钮禁用样式 */
.pay-btn.disabled {
  background-color: #ccc !important;
  color: #999 !important;
}

/* 历史考级弹窗 */
.grade-history-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 85%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  max-height: 75vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.history-item {
  padding: 20rpx 0;
}

.history-item view {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.divider {
  height: 1rpx;
  background-color: #eee;
  margin-top: 15rpx;
} 


.vip-fee-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.2);
}

.vip-fee-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.vip-fee-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.vip-fee-status {
  display: flex;
  align-items: center;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding-bottom: 30rpx;
}

/* 考级课时卡片样式 */
.courses-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(245, 87, 108, 0.2);
}

.courses-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.courses-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.courses-status {
  display: flex;
  align-items: baseline;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.courses-count {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.courses-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 4rpx;
}

.courses-progress-wrapper {
  margin-bottom: 16rpx;
}

.courses-progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 10rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 8rpx;
}

.courses-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
  border-radius: 10rpx;
  transition: width 0.5s ease;
  box-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.3);
}

.courses-progress-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  text-align: right;
}

.courses-tip {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.courses-tip-success {
  background-color: rgba(76, 175, 80, 0.3);
}

.courses-tip-warning {
  
  border: 2rpx solid rgba(255, 152, 0, 0.5);
  
}

.vip-pay-btn {
  background-color: #ffffff;
  color: #667eea;
  font-size: 28rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 一键刷课按钮 */
.quick-class-btn {
  background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 152, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.quick-class-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.4);
}


/* 课时未配置警告样式 */
.config-warning {
  margin: 20rpx auto;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe8cc 100%);
  border-radius: 12rpx;
  border: 2rpx solid #ff9800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
  
}

.warning-icon {
  font-size: 32rpx;
  animation: shake 2s infinite;
}

.warning-text {
  font-size: 26rpx;
  color: white;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
}

/* 课时查看提示 */
.courses-view-hint {
  margin-top: 16rpx;
  padding: 8rpx 0;
  text-align: center;
}

.hint-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-style: italic;
}

.status-paid {

  color: black;
}

.status-unpaid {

  color: red;
}