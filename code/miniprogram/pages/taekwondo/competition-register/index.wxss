/* 比赛报名页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 32rpx;
  padding-bottom: 80rpx;
  
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  color: white;
  font-size: 32rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  z-index: 10;
}

/* 页面标题 */
.header {
  padding: 10rpx 0 32rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 16rpx;
}

.competition-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 参赛要求 */
.requirement-box {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);

  width: 80%;
  text-align: center;
}

.requirement-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.requirement-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.requirement-item:last-child {
  margin-bottom: 0;
}

.requirement-label {
  color: #666;
  font-weight: 500;
}

.requirement-value {
  color: #667eea;
  font-weight: 700;
}

/* 表单容器 */
.form-container {
  background: white;
  border-radius: 24rpx;
  width: 100%;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 4rpx;
}

.input {
  width: 90%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input:focus {
  background: white;
  border-color: #667eea;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 24rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.radio-item.active {
  background: #e6f7ff;
  border-color: #667eea;
}

.radio-icon {
  font-size: 32rpx;
  color: #667eea;
  margin-right: 8rpx;
}

.radio-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 信息提示（身份证解析结果） */
.info-hint {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f0f9ff;
  border-radius: 8rpx;
  border-left: 4rpx solid #667eea;
}

.hint-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

/* 提示信息 */
.tips {
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  color: #fa8c16;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tips-content {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.tips-content:last-child {
  margin-bottom: 0;
}

/* 协议勾选样式 */
.agreement-box {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.agreement-wrapper {
  display: flex;
  align-items: flex-start;
}

.checkbox-wrapper {
  flex-shrink: 0;
  margin-right: 8rpx;
}

.agreement-text-wrapper {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-text {
  color: #666;
  margin: 0 4rpx;
}

.agreement-link {
  color: #667eea;
  text-decoration: underline;
  margin: 0 2rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

