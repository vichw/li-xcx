/* pages/feedback/feedback-list/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  width: 80%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.add-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 28rpx;
}

.add-btn .icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* Tab切换 */
.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  width: 90%;
  
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  border: gray 1px solid;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #667eea;
  border-radius: 3rpx;
}

/* 列表容器 */
.list-container {
  padding: 20rpx 30rpx;
  width: 90%;
}

/* 反馈项 */
.feedback-item {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 类型标签 */
.type-badge {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.type-complaint {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.type-suggestion {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

/* 未读标记 */
.unread-badge {
  position: absolute;
  top: 100rpx;
  right: 30rpx;
  padding: 6rpx 16rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 25rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.unread-badge::before {
  content: '●';
  margin-right: 6rpx;
  font-size: 16rpx;
}

/* 内容区 */
.content-area {
  padding-right: 100rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.category {
  flex-shrink: 0;
  color: #667eea;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 底部信息 */
.footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
}

.image-count {
  display: flex;
  align-items: center;
  color: #999;
}

.image-count .icon {
  margin-right: 6rpx;
}

.status {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
}

.status-pending {
  background: #d9d9d9;
}

.status-processing {
  background: #faad14;
}

.status-resolved {
  background: #52c41a;
}

.status-closed {
  background: #8c8c8c;
}

.time {
  color: #999;
  margin-left: auto;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-image {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 50rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* 加载提示 */
.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

