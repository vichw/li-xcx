.container {
  padding: 24rpx;
  background: #f7f8fa;
  min-height: 100vh;
}
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #222;
}
.history-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.item-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.item-label {
  color: #333;
  min-width: 120rpx;
  font-size: 28rpx;
  text-align: left;
}
.label-bold {
  font-weight: bold;
}
.item-value {
  color: #222;
  font-size: 28rpx;
  text-align: left;
  word-break: break-all;
}
.divider {
  height: 1px;
  background: #e0e0e0;
  margin: 18rpx 0 0 0;
}
.score-table {
  width: 100%;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  background: #f8f8f8;
  padding: 8rpx 0 8rpx 0;
}
.score-table-header {
  display: flex;
  font-weight: bold;
  background: #f0f0f0;
  border-bottom: 1px solid #e0e0e0;
}
.score-th {
  flex: 1;
  padding: 8rpx 0 8rpx 12rpx;
  color: #333;
  font-size: 26rpx;
  text-align: left;
}
.score-table-row {
  display: flex;
  border-bottom: 1px solid #ececec;
}
.score-table-row:last-child {
  border-bottom: none;
}
.score-td {
  flex: 1;
  padding: 8rpx 0 8rpx 12rpx;
  color: #222;
  font-size: 26rpx;
  text-align: left;
  word-break: break-all;
}
.record-card {
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  margin-bottom: 36rpx;
  background: #fff;
  padding: 32rpx 20rpx;
} 